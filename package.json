{
  "name": "@jake-gao/vue3-hiprint",
  "description": "基于 hiprint 的 Vue3 可视化打印设计器",
  "version": "1.0.4",
  "author": "jake-gao",
  "license": "MIT",
  "main": "dist/vue3-hiprint.js",
  "module": "dist/vue3-hiprint.esm.js",
  "exports": {
    ".": {
      "import": "./dist/vue3-hiprint.esm.js",
      "require": "./dist/vue3-hiprint.js"
    },
    "./dist/print-lock.css": "./dist/print-lock.css",
    "./dist/vue3-hiprint.js": "./dist/vue3-hiprint.js",
    "./dist/vue3-hiprint.esm.js": "./dist/vue3-hiprint.esm.js"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a395027720/vue3-hiprint.git"
  },
  "bugs": {
    "url": "https://github.com/a395027720/vue3-hiprint/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "hiprint",
    "print",
    "template",
    "designer"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.config.app.js",
    "build-demo": "vite build --config vite.config.app.js && : > demo/.nojekyll",
    "build-lib": "vite build --config vite.config.lib.js",
    "build": "npm run build-lib",
    "pub": "npm run build && npm --registry https://registry.npmjs.org/ publish",
    "pub-beta": "npm run build && npm --registry https://registry.npmjs.org/ publish --tag beta",
    "up-version": "node ./scripts/change-version.js"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.80.0",
    "vite": "^5.0.0",
    "vite-plugin-css-injected-by-js": "~4.0.1"
  },
  "dependencies": {
    "@claviska/jquery-minicolors": "^2.3.6",
    "ant-design-vue": "^2.1.6",
    "bwip-js": "^4.0.0",
    "canvg": "^3.0.10",
    "concurrent-tasks": "^1.0.7",
    "dom-to-image-more": "3.7.2",
    "jquery": "^3.6.0",
    "jsbarcode": "^3.11.5",
    "jspdf": "^2.5.1",
    "lodash": "^4.17.21",
    "nzh": "^1.0.8",
    "socket.io-client": "^4.5.1",
    "vue": "^3.4.0",
    "vue-ls": "^4.0.0"
  }
}
